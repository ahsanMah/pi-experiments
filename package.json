{
  "name": "pi-branches",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Canvas-style conversation branching on pi-durable: a server, a web client, and a terminal client",
  "scripts": {
    "server": "node --experimental-strip-types --no-warnings=ExperimentalWarning server/main.ts",
    "web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "check": "tsc --noEmit -p tsconfig.json && svelte-check --workspace web --tsconfig ./tsconfig.json",
    "smoke": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/smoke.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "^1.4.0",
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-durable": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "@xyflow/svelte": "^1.7.0",
    "marked": "^18.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
